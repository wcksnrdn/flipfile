{
  "name": "flipfile",
  "private": true,
  "version": "0.13.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "dev:packs": "node scripts/packs.mjs dev --slow",
    "fetch-pdfium": "node scripts/fetch-pdfium.mjs",
    "fetch-models": "node scripts/fetch-models.mjs",
    "fetch-onnxruntime": "node scripts/fetch-onnxruntime.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:rust": "cd src-tauri && cargo clippy --all-targets -- -D warnings",
    "test:web": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test:web",
    "test": "npm run fetch-pdfium && npm run fetch-models && npm run fetch-onnxruntime && cd src-tauri && cargo test",
    "stress": "npm run fetch-pdfium && cd src-tauri && cargo test --lib convert::stress -- --include-ignored",
    "bench": "npm run fetch-pdfium && npm run fetch-models && npm run fetch-onnxruntime && cd src-tauri && cargo test --profile bench --lib convert::bench::bench -- --exact --ignored --nocapture"
  },
  "dependencies": {
    "@fontsource/poppins": "^5.3.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.0.16",
    "vitest": "^5.1.0"
  }
}
