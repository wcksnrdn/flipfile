<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The app is signed ad hoc with the hardened runtime, which only loads libraries
	     signed by the same Team ID. An ad hoc signature has none, so the bundled PDFium
	     (Resources/pdfium/libpdfium.dylib) is refused without this. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
</dict>
</plist>
