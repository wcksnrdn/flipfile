{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Exactly what the main window's UI uses, nothing more (least privilege). The global shortcut, tray, clipboard and file conversion run in Rust and need no UI permission.",
  "windows": ["main"],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:window:allow-scale-factor",
    "core:window:allow-start-dragging",
    "core:window:allow-start-resize-dragging",
    "core:window:allow-set-size",
    "core:window:allow-set-min-size",
    "core:window:allow-set-max-size",
    "core:window:allow-set-resizable",
    "opener:allow-reveal-item-in-dir",
    "allow-convert-batch",
    "allow-read-clipboard",
    "allow-option-key-down",
    "allow-settings-summary",
    "allow-set-glass",
    "allow-set-workshop-window",
    "allow-quit-app",
    "allow-summary-status",
    "allow-summarize",
    "allow-summary-show",
    "updater:default",
    "process:default"
  ]
}
